<header class="utility-header">
	<div class="sheet">
		<div class="utility-header-inner sheet-breakout">
			<a class="utility-header-brand" href="/" aria-label="Spacious Clarity, home">
				<img src="/images/mark.svg" width="24" height="24" alt="" />
				<span>Spacious&nbsp;Clarity</span>
			</a>

			<a class="utility-header-home" href="/">Home</a>
		</div>
	</div>
</header>

<style>
	.utility-header {
		background: var(--header-surface);
		color: var(--ink-on-dark);
		border-bottom: 1px solid var(--header-border);
	}

	.utility-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		min-height: 4.25rem;
	}

	.utility-header-brand,
	.utility-header-home {
		display: inline-flex;
		align-items: center;
		line-height: 1;
	}

	.utility-header-brand {
		min-height: 2.75rem;
		gap: 0.6rem;
		font-family: var(--font-serif);
		font-size: var(--fs-control);
		font-weight: 520;
		letter-spacing: -0.012em;
	}

	.utility-header-brand img {
		flex: 0 0 auto;
	}

	.utility-header-home {
		justify-content: center;
		min-height: 2.75rem;
		padding-inline: 1rem;
		border: 1px solid var(--sun-clay);
		border-radius: var(--radius-sm);
		background: var(--sun-clay);
		color: var(--ink-on-accent);
		font-family: var(--font-sans);
		font-size: var(--fs-caption);
		font-weight: 690;
		user-select: none;
		transition: transform var(--dur-press) var(--ease-standard);
	}

	.utility-header-home:active {
		transform: translateY(var(--press-shift));
	}

	@media (hover: hover) and (pointer: fine) {
		.utility-header-brand,
		.utility-header-home {
			transition:
				color var(--dur-hover) var(--ease-standard),
				background-color var(--dur-hover) var(--ease-standard),
				border-color var(--dur-hover) var(--ease-standard),
				transform var(--dur-press) var(--ease-standard);
		}

		/* Hover cue is a thin clay underline, matching SiteHeader — sun-clay
		   text on the dark band falls short of AA. */
		.utility-header-brand:hover {
			text-decoration: underline;
			text-decoration-color: var(--sun-clay);
			text-decoration-thickness: 1.5px;
			text-underline-offset: 0.35em;
		}

		.utility-header-home:hover {
			border-color: var(--accent-hover);
			background: var(--accent-hover);
		}
	}

	.utility-header-brand:focus-visible,
	.utility-header-home:focus-visible {
		outline-color: var(--ink-on-dark);
	}

	@media (pointer: coarse) {
		.utility-header-home {
			min-height: 3rem;
		}
	}
</style>
