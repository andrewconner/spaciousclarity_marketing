---
/**
 * Sticky brand and section navigation for the homepage. The mark is the
 * Print Terrain identity (layered terrain bands on a paper disc with the
 * sun-clay dot), and the bar’s content follows the same editorial grid as
 * the rest of the page.
 */
---

<header class="site-header">
	<div class="sheet">
		<div class="site-header-inner sheet-breakout">
			<a class="site-header-mark" href="/" aria-label="Spacious Clarity, home">
				<svg viewBox="0 0 64 64" width="24" height="24" fill="none" aria-hidden="true">
					<defs>
						<clipPath id="header-mark-paper"><circle cx="32" cy="32" r="31.25"></circle></clipPath>
					</defs>
					<circle
						cx="32"
						cy="32"
						r="31.25"
						style="fill: var(--ivory); stroke: var(--stone)"
						stroke-width="1.5"></circle>
					<g clip-path="url(#header-mark-paper)">
						<path
							d="M-2 38 C12 33 26 32 38 35.5 C48 38.5 58 37 66 33.5 L66 66 H-2 Z"
							style="fill: var(--misty-blue)"></path>
						<path
							d="M-2 47 C10 42.5 24 42 36 45 C46 47.5 58 46.5 66 43.5 L66 66 H-2 Z"
							style="fill: var(--sage)"></path>
						<path
							d="M-2 55 C12 51 26 51 38 53.5 C48 55.5 58 55 66 52 L66 66 H-2 Z"
							style="fill: var(--lichen)"></path>
					</g>
					<circle cx="43" cy="16" r="5.4" style="fill: var(--sun-clay)"></circle>
				</svg>
				<span>Spacious Clarity</span>
			</a>

			<nav class="site-header-nav" aria-label="On this page">
				<a href="#method">Practice</a>
				<a href="#course">Why adaptive</a>
				<a href="#changes">What changes</a>
				<a href="#fit">Is it for me?</a>
			</nav>

			<a class="site-header-cta" href="#begin">Join the waitlist</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding-top: env(safe-area-inset-top);
		background: var(--header-surface);
		color: var(--ink-on-dark);
		border-bottom: 1px solid var(--header-border);
		box-shadow: 0 0.35rem 1.4rem color-mix(in oklch, var(--midnight) 18%, transparent);
	}

	.site-header-inner {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-areas: 'brand nav cta';
		align-items: center;
		gap: var(--space-md);
		min-height: 4.25rem;
	}

	.site-header-mark {
		grid-area: brand;
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		gap: 0.6rem;
		font-family: var(--font-serif);
		font-size: var(--fs-control);
		font-weight: 520;
		letter-spacing: -0.012em;
		white-space: nowrap;
	}

	.site-header-mark svg {
		flex: 0 0 auto;
	}

	.site-header-nav {
		grid-area: nav;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: clamp(0.1rem, 0.4vw, 0.35rem);
		min-width: 0;
	}

	.site-header-nav a,
	.site-header-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		line-height: 1;
		white-space: nowrap;
	}

	.site-header-nav a {
		padding-inline: clamp(0.45rem, 0.7vw, 0.75rem);
		font-family: var(--font-serif);
		font-size: var(--fs-control-sm);
		font-weight: 470;
		letter-spacing: -0.01em;
		/* 91% keeps the resting links a step quieter than full ink while still
		   clearing APCA 75 on the header band. */
		color: color-mix(in oklch, var(--ink-on-dark) 91%, transparent);
	}

	/* "You are here" as full-ink text plus a clay underline: sun-clay text on
	   the dark band falls short of AA, and the underline keeps the cue
	   visible without relying on hue alone. */
	.site-header-nav a[aria-current='location'] {
		color: var(--ink-on-dark);
		text-decoration: underline;
		text-decoration-color: var(--sun-clay);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.35em;
	}

	.site-header-cta {
		grid-area: cta;
		justify-self: end;
		padding-inline: 1rem;
		border: 1px solid var(--sun-clay);
		border-radius: var(--radius-sm);
		background: var(--sun-clay);
		color: var(--ink-on-accent);
		font-family: var(--font-sans);
		font-size: var(--fs-caption);
		font-weight: 690;
		user-select: none;
		transition: transform var(--dur-press) var(--ease-standard);
	}

	.site-header-cta:active {
		transform: translateY(var(--press-shift));
	}

	@media (hover: hover) and (pointer: fine) {
		.site-header-mark,
		.site-header-nav a,
		.site-header-cta {
			transition:
				color var(--dur-hover) var(--ease-standard),
				background-color var(--dur-hover) var(--ease-standard),
				border-color var(--dur-hover) var(--ease-standard),
				transform var(--dur-press) var(--ease-standard);
		}

		/* Hover brightens to full ink; the mark gets a thin clay underline so
		   its cue survives without sub-AA sun-clay text. */
		.site-header-nav a:hover {
			color: var(--ink-on-dark);
		}

		.site-header-mark:hover {
			text-decoration: underline;
			text-decoration-color: var(--sun-clay);
			text-decoration-thickness: 1.5px;
			text-underline-offset: 0.35em;
		}

		.site-header-cta:hover {
			border-color: var(--accent-hover);
			background: var(--accent-hover);
		}
	}

	.site-header-mark:focus-visible,
	.site-header-nav a:focus-visible,
	.site-header-cta:focus-visible {
		outline: 2px solid var(--ink-on-dark);
		outline-offset: 3px;
	}

	@media (max-width: 62rem) {
		.site-header-inner {
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-areas: 'brand cta';
			gap: var(--space-sm);
		}

		.site-header-nav {
			display: none;
		}
	}

	@media (pointer: coarse) {
		.site-header-cta {
			min-height: 3rem;
		}
	}

	@media (max-width: 22rem) {
		.site-header-inner {
			gap: var(--space-2xs);
		}

		.site-header-mark {
			gap: 0.45rem;
			font-size: var(--fs-control-sm);
		}

		.site-header-cta {
			padding-inline: 0.7rem;
			font-size: 0.75rem;
		}
	}
</style>

<script>
	const sectionLinks = Array.from(
		document.querySelectorAll<HTMLAnchorElement>('.site-header-nav a[href^="#"]'),
	);
	const linkedSections = sectionLinks
		.map((link) => document.getElementById(link.hash.slice(1)))
		.filter((section): section is HTMLElement => section instanceof HTMLElement);

	const setCurrentSection = (id: string) => {
		for (const link of sectionLinks) {
			if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		}
	};

	if ('IntersectionObserver' in window) {
		const sectionObserver = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) setCurrentSection(entry.target.id);
				}
			},
			{ rootMargin: '-20% 0px -70% 0px' },
		);

		linkedSections.forEach((section) => sectionObserver.observe(section));
	}

	sectionLinks.forEach((link) => {
		link.addEventListener('click', () => setCurrentSection(link.hash.slice(1)));
	});
</script>
