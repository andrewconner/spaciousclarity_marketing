---
/**
 * Sticky brand and section navigation for the homepage. The mark is the
 * Print Terrain identity (layered terrain bands on a paper disc with the
 * sun-clay dot), and the bar's content follows the same editorial grid as
 * the rest of the page.
 */
---

<header class="site-header">
	<div class="sheet">
		<div class="site-header-inner sheet-breakout">
			<a class="site-header-mark" href="/" aria-label="Spacious Clarity, home">
				<svg viewBox="0 0 64 64" width="24" height="24" fill="none" aria-hidden="true">
					<defs>
						<clipPath id="header-mark-paper"><circle cx="32" cy="32" r="31.25"></circle></clipPath>
					</defs>
					<circle cx="32" cy="32" r="31.25" fill="#F6F2EA" stroke="#D9D1C4" stroke-width="1.5"></circle>
					<g clip-path="url(#header-mark-paper)">
						<path d="M-2 38 C12 33 26 32 38 35.5 C48 38.5 58 37 66 33.5 L66 66 H-2 Z" fill="#B7C2C8"></path>
						<path d="M-2 47 C10 42.5 24 42 36 45 C46 47.5 58 46.5 66 43.5 L66 66 H-2 Z" fill="#99A68D"></path>
						<path d="M-2 55 C12 51 26 51 38 53.5 C48 55.5 58 55 66 52 L66 66 H-2 Z" fill="#55624B"></path>
					</g>
					<circle cx="43" cy="16" r="5.4" fill="#C87435"></circle>
				</svg>
				<span>Spacious Clarity</span>
			</a>

			<nav class="site-header-nav" aria-label="On this page">
				<a href="#method">Practice</a>
				<a href="#course">Why adaptive</a>
				<a href="#teacher">Charlie</a>
				<a href="#fit">Is it for me?</a>
				<a href="#questions">Questions</a>
			</nav>

			<a class="site-header-cta" href="#hero-email">Early Access</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding-top: env(safe-area-inset-top);
		background: color-mix(in oklch, var(--terrain) 88%, var(--lichen));
		color: var(--ink-on-dark);
		border-bottom: 1px solid color-mix(in oklch, var(--ink-on-dark) 18%, transparent);
		box-shadow: 0 0.35rem 1.4rem color-mix(in oklch, var(--midnight) 18%, transparent);
	}

	.site-header-inner {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-areas: 'brand nav cta';
		align-items: center;
		gap: var(--space-md);
		min-height: 4.25rem;
	}

	.site-header-mark {
		grid-area: brand;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-sans);
		font-size: 0.875rem;
		font-weight: 650;
		letter-spacing: 0.055em;
		white-space: nowrap;
	}

	.site-header-mark svg {
		flex: 0 0 auto;
	}

	.site-header-nav {
		grid-area: nav;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: clamp(0.1rem, 0.4vw, 0.35rem);
		min-width: 0;
	}

	.site-header-nav a,
	.site-header-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 580;
		line-height: 1;
		white-space: nowrap;
	}

	.site-header-nav a {
		padding-inline: clamp(0.45rem, 0.7vw, 0.75rem);
		color: color-mix(in oklch, var(--ink-on-dark) 82%, transparent);
	}

	.site-header-cta {
		grid-area: cta;
		justify-self: end;
		padding-inline: 1rem;
		border: 1px solid var(--sun-clay);
		border-radius: var(--radius-sm);
		background: var(--sun-clay);
		color: var(--midnight);
		font-weight: 690;
	}

	@media (hover: hover) and (pointer: fine) {
		.site-header-mark,
		.site-header-nav a,
		.site-header-cta {
			transition:
				color 180ms cubic-bezier(0.22, 1, 0.36, 1),
				background-color 180ms cubic-bezier(0.22, 1, 0.36, 1),
				border-color 180ms cubic-bezier(0.22, 1, 0.36, 1);
		}

		.site-header-mark:hover,
		.site-header-nav a:hover {
			color: var(--sun-clay);
		}

		.site-header-cta:hover {
			border-color: color-mix(in oklch, var(--sun-clay) 78%, var(--ink-on-dark));
			background: color-mix(in oklch, var(--sun-clay) 78%, var(--ink-on-dark));
		}
	}

	.site-header-mark:focus-visible,
	.site-header-nav a:focus-visible,
	.site-header-cta:focus-visible {
		outline: 2px solid var(--ink-on-dark);
		outline-offset: 3px;
	}

	@media (max-width: 62rem) {
		.site-header-inner {
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-areas:
				'brand cta'
				'nav nav';
			gap: 0 var(--space-sm);
			padding-top: var(--space-2xs);
		}

		.site-header-nav {
			justify-content: flex-start;
			gap: 0;
			overflow-x: auto;
			padding-bottom: var(--space-2xs);
			scrollbar-width: none;
		}

		.site-header-nav::-webkit-scrollbar {
			display: none;
		}

		.site-header-nav a:first-child {
			padding-left: 0;
		}
	}

	@media (pointer: coarse) {
		.site-header-nav a,
		.site-header-cta {
			min-height: 3rem;
		}
	}
</style>
