---
/**
 * The brand bar. It lives in the page flow directly beneath the hero, then
 * pins to the top of the viewport as the reader scrolls. The mark is the
 * contour identity (two terrain strokes and the sun-clay dot). Its content
 * aligns to the page's centered column, not the viewport edges.
 */
---

<header class="site-header" aria-label="Spacious Clarity">
	<div class="sheet">
		<div class="site-header-inner sheet-breakout">
			<p class="site-header-mark">
				<svg viewBox="0 0 64 64" width="24" height="24" fill="none" aria-hidden="true">
					<g
						stroke="currentColor"
						stroke-width="4"
						stroke-linecap="round"
						stroke-linejoin="round"
						opacity="0.8"
					>
						<path d="M 6 46 C 16 41 26 41 34 43 C 44 46 52 48 58 46"></path>
						<path d="M 12 32 C 21 27 30 27 38 29 C 46 31 52 31 58 29"></path>
					</g>
					<circle cx="45" cy="16" r="8" fill="#C87435"></circle>
				</svg>
				<span>Spacious Clarity</span>
			</p>
			<span class="site-header-meta">An Opening Awareness Course</span>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		padding: 0.85rem 0;
		background: var(--midnight);
		color: var(--ink-on-dark);
		border-bottom: 1px solid color-mix(in srgb, var(--ink-on-dark) 16%, transparent);
	}

	.site-header-inner {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.site-header-mark {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}

	.site-header-mark svg {
		transform: translateY(0.15rem);
		flex: 0 0 auto;
	}

	.site-header-meta {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 0.95rem;
		color: color-mix(in srgb, var(--ink-on-dark) 75%, transparent);
		white-space: nowrap;
	}

	@media (max-width: 40rem) {
		.site-header-meta {
			display: none;
		}
	}
</style>
