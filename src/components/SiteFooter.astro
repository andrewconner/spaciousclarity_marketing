---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="sheet">
		<div class="site-footer-inner sheet-breakout">
			<a class="site-footer-brand" href="/">
				<img src="/images/mark.svg" width="32" height="32" alt="" />
				<span>Spacious&nbsp;Clarity</span>
			</a>

			<nav class="site-footer-links" aria-label="Footer">
				<a href="https://charlieawbery.substack.com/" target="_blank"> Charlie on Substack </a>
				<a href="https://www.evolvingground.org/" target="_blank"> Evolving Ground </a>
				<a href="mailto:hi@spaciousclarity.com">Contact</a>
			</nav>

			<p class="site-footer-meta">&copy; {year} Spacious&nbsp;Clarity.</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding: var(--space-2xl) 0 var(--space-xl);
		background: var(--surface-dark);
		color: var(--ink-on-dark);
		border-top: 1px solid var(--rule-dark);
	}

	.site-footer-inner {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		grid-template-areas:
			'brand links'
			'meta links';
		gap: var(--space-2xs) var(--space-xl);
		align-items: start;
	}

	.site-footer-brand {
		grid-area: brand;
		display: inline-flex;
		align-items: center;
		/* Pad the hit area to ~44px; the negative margin keeps the layout put. */
		padding: 0.35rem 0;
		margin: -0.35rem 0;
		gap: 0.65rem;
		font-family: var(--font-sans);
		font-size: var(--fs-control-sm);
		font-weight: 650;
		/* Sentence case, not uppercase — tracking eased accordingly. */
		letter-spacing: 0.03em;
	}

	.site-footer-brand img {
		flex: 0 0 auto;
	}

	.site-footer-links {
		grid-area: links;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: var(--space-sm) var(--space-lg);
		margin: -0.65rem 0;
	}

	.site-footer-links a,
	.site-footer-meta {
		font-family: var(--font-sans);
		font-size: var(--fs-caption);
		letter-spacing: 0.01em;
	}

	.site-footer-links a {
		/* Pad the hit area to ~40px; the container’s negative margin compensates. */
		padding: 0.65rem 0;
		color: color-mix(in srgb, var(--ink-on-dark) 88%, transparent);
		transition: color var(--dur-hover) var(--ease-standard);
	}

	@media (hover: hover) and (pointer: fine) {
		/* Hover brightens to full ink, matching Colophon — sun-clay text on
		   midnight falls short of AA. */
		.site-footer-links a:hover {
			color: var(--ink-on-dark);
		}
	}

	.site-footer-meta {
		grid-area: meta;
		margin: 0;
		/* De-emphasized, but 76% still clears APCA 60 on midnight. */
		color: color-mix(in srgb, var(--ink-on-dark) 76%, transparent);
	}

	@media (max-width: 48rem) {
		.site-footer-inner {
			grid-template-columns: 1fr;
			grid-template-areas:
				'brand'
				'links'
				'meta';
			gap: var(--space-md);
		}

		.site-footer-links {
			justify-content: flex-start;
		}
	}
</style>
