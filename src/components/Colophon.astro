---
/**
 * The page's one structural midnight band, set like a book colophon: the
 * mark, two honest sentences, the form, a real footnote, and the footer links
 * — all in the same grounded ending. The entire navy budget lives here.
 */
import WaitlistForm from './WaitlistForm.astro';

const year = new Date().getFullYear();
---

<footer class="colophon grain grain--overlay" id="begin" aria-labelledby="colophon-heading">
	<div class="sheet">
		<div class="colophon-inner">
			<div class="colophon-mark" aria-hidden="true">
				<svg viewBox="0 0 64 40" width="64" height="40" fill="none">
					<g
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						opacity="0.7"
					>
						<path d="M 4 32 C 12 28 20 28 28 30 C 36 32 44 34 60 32"></path>
						<path d="M 8 22 C 16 18 24 18 32 20 C 40 22 48 22 56 20"></path>
					</g>
					<circle cx="44" cy="10" r="4.5" fill="#C87435"></circle>
				</svg>
			</div>

			<h2 id="colophon-heading" class="colophon-heading">Get early access to the course.</h2>

			<p class="colophon-copy">
				We're actively building and testing the course, and adding new people on a rolling basis.
				Leave your email and we'll keep you included as we expand access. When it opens fully, it
				will be a one-time purchase, with no subscription; the incentives should point at your
				graduation, not your retention.
			</p>

			<WaitlistForm box="closing" tone="dark" class="colophon-waitlist" />

			<p class="colophon-footnote">
				<span aria-hidden="true">*</span> We write when spots open. Unsubscribe anytime.
			</p>

			<div class="colophon-rule" aria-hidden="true"></div>

			<nav class="colophon-links" aria-label="Footer">
				<a href="https://charlieawbery.substack.com/" target="_blank" rel="noreferrer">
					Charlie on Substack
				</a>
				<a href="https://www.evolvingground.org/" target="_blank" rel="noreferrer">
					Evolving Ground
				</a>
				<a href="mailto:hi@spaciousclarity.com">Contact</a>
			</nav>

			<p class="colophon-meta">&copy; {year} Spacious Clarity.</p>
		</div>
	</div>
</footer>

<style>
	.colophon {
		background: var(--surface-dark);
		color: var(--ink-on-dark);
		padding: clamp(4rem, 6vw + 1rem, 7rem) 0 clamp(2.5rem, 3vw + 1rem, 4rem);
	}

	.colophon-inner {
		display: grid;
		gap: var(--space-sm);
		max-width: var(--measure);
	}

	.colophon-mark {
		color: var(--ink-on-dark);
		margin-bottom: 0.5rem;
	}

	.colophon-heading {
		font-size: clamp(2rem, 1.35rem + 2.4vw, 3rem);
		font-weight: 390;
		letter-spacing: -0.018em;
		line-height: 1.08;
		color: var(--ink-on-dark);
		margin: 0;
	}

	.colophon-copy {
		font-size: var(--fs-body);
		line-height: 1.65;
		color: color-mix(in srgb, var(--ink-on-dark) 82%, transparent);
		margin: 0;
		max-width: 38rem;
	}

	.colophon-waitlist {
		margin-top: clamp(0.75rem, 1.5vw, 1.5rem);
		max-width: 34rem;
	}

	.colophon-footnote {
		font-family: var(--font-sans);
		font-size: var(--fs-caption);
		letter-spacing: 0.02em;
		color: color-mix(in srgb, var(--ink-on-dark) 60%, transparent);
		margin: 0;
	}

	.colophon-rule {
		border-top: 1px solid var(--rule-dark);
		margin-top: clamp(2.5rem, 4vw, 4rem);
	}

	.colophon-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm) var(--space-lg);
		padding-top: 0.5rem;
	}

	.colophon-links a {
		font-family: var(--font-sans);
		font-size: var(--fs-caption);
		letter-spacing: 0.02em;
		color: color-mix(in srgb, var(--ink-on-dark) 75%, transparent);
		transition: color 180ms ease;
	}

	.colophon-links a:hover {
		color: var(--ink-on-dark);
	}

	.colophon-meta {
		font-family: var(--font-sans);
		font-size: var(--fs-caption);
		color: color-mix(in srgb, var(--ink-on-dark) 45%, transparent);
		margin: 0;
	}
</style>
