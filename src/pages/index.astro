---
import ApproachSection from '../components/ApproachSection.astro';
import Colophon from '../components/Colophon.astro';
import ContourDivider from '../components/ContourDivider.astro';
import FaqSection from '../components/FaqSection.astro';
import FitSection from '../components/FitSection.astro';
import Hero from '../components/Hero.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import MethodSection from '../components/MethodSection.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TeacherSection from '../components/TeacherSection.astro';
import WhatChangesSection from '../components/WhatChangesSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout path="/" preloadItalicFont>
	<SiteHeader />

	<main id="main-content" class="main-home">
		<Hero />
		<MethodSection />
		<ApproachSection />
		<HowItWorksSection />
		<ContourDivider variant={2} />
		<TeacherSection />
		<WhatChangesSection />
		<FitSection />
		<FaqSection />
	</main>

	<Colophon />
</BaseLayout>
