---
import UtilityPage from '../components/UtilityPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="You're on the waitlist | Spacious Clarity"
	description="Thank you for joining the Spacious Clarity waitlist."
	path="/waitlist"
	noindex={true}
>
	<UtilityPage
		headingId="waitlist-heading"
		marker="sun"
		context="Check your inbox"
		title="Please confirm your email."
	>
		<p>
			Look for a confirmation message from hi@spaciousclarity.com. If it doesn't arrive within a few
			minutes, check your spam folder.
		</p>
		<p>We'll send course access details as new spots open.</p>
		<p>
			While you wait: Charlie's book,
			<a href="https://www.evolvingground.org/opening-awareness" rel="noreferrer"
				><cite>Opening Awareness</cite></a
			>, is the long-form version of the method, and
			<a href="https://charlieawbery.substack.com/" rel="noreferrer">the Substack</a>
			carries ongoing practice notes.
		</p>

		<a slot="actions" class="button" href="/">Return to the homepage</a>
	</UtilityPage>
</BaseLayout>
