---
import UtilityPage from '../components/UtilityPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Page not found | Spacious Clarity"
	description="The page you were looking for could not be found."
	path="/404"
	noindex={true}
>
	<UtilityPage
		headingId="notfound-heading"
		marker="404"
		context="Page not found"
		title="That page isn’t here."
	>
		<p>The address may be outdated, or the page may have moved.</p>

		<a slot="actions" class="button" href="/">Return to the homepage</a>
	</UtilityPage>
</BaseLayout>
